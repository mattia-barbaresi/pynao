<?xml version="1.0"?>
<package format="2">
  <name>pynao</name>
  <version>0.0.0</version>
  <description>The pynao package uses python to control Nao robot</description>

  <maintainer email="mattia.barbaresi@gmail.com">mattia</maintainer>

  <!-- Commonly used license strings: -->
  <!--   BSD, MIT, Boost Software License, GPLv2, GPLv3, LGPLv2.1, LGPLv3 -->
  <license>GPLv3</license>

  <build_depend>message_generation</build_depend>
  <exec_depend>message_runtime</exec_depend>
  <buildtool_depend>catkin</buildtool_depend>

  <!-- Ros dependencies -->
  <depend>roscpp</depend>
  <depend>rospy</depend>
  <depend>std_msgs</depend>

  <!-- moveit and Nao dependencies  -->
  <depend>nao_moveit_config</depend>
  <depend>moveit_commander</depend>

  <!-- The export tag contains other, unspecified, tags -->
  <export>
    <!-- Other tools can request additional information be placed here -->
  </export>
</package>
